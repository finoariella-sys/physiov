rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper ─────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isDoctor() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "doctor";
    }

    // ─── Users ──────────────────────────────────────────────────────────
    // CEGAH PRIVILEGE ESCALATION: user TIDAK boleh mengubah field role-nya
    // sendiri setelah role awal ditetapkan (self-create hanya boleh role
    // "patient"; self-update wajib role tetap sama). Perubahan role / data
    // user lain HANYA boleh dilakukan oleh admin.
    match /users/{userId} {
      // Read: profil sendiri, semua profil dokter (dropdown pasien & admin),
      // profil pasien untuk dokter, dan semua data untuk admin.
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        resource.data.role == "doctor" ||
        (resource.data.role == "patient" && isDoctor()) ||
        isAdmin()
      );

      // Create: self-registration HANYA boleh berperan "patient";
      // akun berrole doctor/admin hanya bisa dibuat oleh admin.
      allow create: if isSignedIn() && (
        (request.auth.uid == userId && request.resource.data.role == "patient") ||
        isAdmin()
      );

      // Update: self boleh mengubah datanya sendiri SELAMA field role TIDAK
      // berubah (request.resource.data.role == resource.data.role).
      // Hanya admin yang boleh mengubah role.
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && request.resource.data.role == resource.data.role) ||
        isAdmin()
      );

      // Delete: hanya admin.
      allow delete: if isAdmin();
    }

    // ─── Exercises ──────────────────────────────────────────────────────
    match /exercises/{exerciseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── Complaints ─────────────────────────────────────────────────────
    match /complaints/{complaintId} {
      allow create: if isSignedIn() && request.resource.data.patientId == request.auth.uid;
      allow read: if isSignedIn() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        resource.data.doctorId == request.auth.uid ||
        isAdmin()
      );
    }

    // ─── Prescriptions ──────────────────────────────────────────────────
    match /prescriptions/{prescriptionId} {
      allow create: if isSignedIn() && request.resource.data.doctorId == request.auth.uid;
      allow read: if isSignedIn() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid ||
        isAdmin()
      );
      // PERBAIKAN: rule "update" ditambahkan agar updatePrescriptionStatus
      // ("completed" saat target reps tercapai) berhasil dieksekusi dokter pemilik.
      allow update: if isSignedIn() && (
        resource.data.doctorId == request.auth.uid ||
        isAdmin()
      );
    }

    // ─── Sessions ────────────────────────────────────────────────────────
    match /sessions/{sessionId} {
      allow create: if isSignedIn() && request.resource.data.patientId == request.auth.uid;
      allow read: if isSignedIn() && (
        resource.data.patientId == request.auth.uid ||
        isAdmin() ||
        // Dokter bisa baca sesi pasien yang ditanganinya (via prescription terkait)
        exists(/databases/$(database)/documents/prescriptions/$(resource.data.prescriptionId)) &&
        get(/databases/$(database)/documents/prescriptions/$(resource.data.prescriptionId)).data.doctorId == request.auth.uid
      );
      allow update: if isSignedIn() && (
        resource.data.patientId == request.auth.uid ||
        isAdmin() ||
        exists(/databases/$(database)/documents/prescriptions/$(resource.data.prescriptionId)) &&
        get(/databases/$(database)/documents/prescriptions/$(resource.data.prescriptionId)).data.doctorId == request.auth.uid
      );
    }

    // ─── Chat Messages ───────────────────────────────────────────────────
    match /chatMessages/{messageId} {
      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.senderId &&
        request.auth.uid in request.resource.data.participants;
      // Read mencakup dokumen per-item DAN hasil query (list) sekaligus:
      // karena tiap dokumen kembalian query harus lolos aturan read,
      // query where("participants","array-contains", uid) otomatis aman
      // tanpa perlu klausa "allow list" terpisah.
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      // PERBAIKAN: rule "delete" ditambahkan untuk trimOldMessages
      // (pembersih pesan lama > 100 per percakapan).
      allow delete: if isSignedIn() && request.auth.uid in resource.data.participants;
    }
  }
}